        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "visible": false,
        "url": "workbench.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "publisher": "luguochang",
    "homepage": "https://github.com/luguochang/meeting-copilot",
    "copyright": "Copyright (c) 2026 luguochang",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  }
}
