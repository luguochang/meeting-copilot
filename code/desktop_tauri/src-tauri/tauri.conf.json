{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talktrace",
  "version": "0.1.0",
  "identifier": "com.meetingcopilot.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8765/",
    "frontendDist": "../../web_mvp/frontend_v2/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "言迹 Talktrace",
