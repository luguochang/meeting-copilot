# Local data. Keep this directory outside source control.
MEETING_COPILOT_DATA_DIR=./data/local_runtime/web_mvp

# OpenAI-compatible AI service. The web "AI settings" can save an override.
# Leave the key empty until you enter your own key here or in the page.
# This endpoint/model is an example; confirm availability with your provider.
LLM_GATEWAY_BASE_URL=https://codexai.club
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=gpt-6-sol
LLM_GATEWAY_REALTIME_MODEL=gpt-6-sol
LLM_GATEWAY_CORRECTION_MODEL=gpt-6-sol
LLM_GATEWAY_API_STYLE=responses
LLM_GATEWAY_TIMEOUT_SECONDS=60

# New meetings explicitly prepared for participation use low-frequency understanding
# and automatic contributions. Legacy/no-preparation meetings keep their engine.
MEETING_COPILOT_DISCUSSION_STATE_ENABLED=1
MEETING_COPILOT_DISCUSSION_AUTOMATIC_ENABLED=1
# Set AUTOMATIC_ENABLED=0 to stop new contribution admission; STATE_ENABLED=0
# separately stops new understanding. Neither cancels queued/running work or
# controls legacy analysis, explicit Ask/manual requests, or expands budgets.

# Optional explicit outbound proxy (empty means direct; never shipped to UI).
LLM_GATEWAY_PROXY_URL=

# Optional local API override for frontend development.
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8765
